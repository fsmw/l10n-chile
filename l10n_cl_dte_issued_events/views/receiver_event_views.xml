<odoo>
    <record id="view_receiver_event_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.receiver.event.list</field>
        <field name="model">l10n_cl.dte.receiver.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="event_date" />
                <field name="event_date_key" optional="hide" />
                <field name="source" />
                <field name="event_code" />
                <field name="description" />
                <field name="actor_vat" />
                <field
                    name="receiver_state"
                    widget="badge"
                    decoration-danger="is_claim"
                />
                <field name="is_claim" column_invisible="1" />
                <field name="response_id" optional="show" />
                <field name="document_id" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>
</odoo>
