<odoo>
    <record id="view_move_form_dte_receiver_state" model="ir.ui.view">
        <field name="name">account.move.form.dte.receiver.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
                <field
                    name="dte_receiver_state"
                    widget="badge"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="dte_receiver_state == 'none'"
                    decoration-success="dte_receiver_state in ['accepted', 'goods_received', 'tacit', 'paid']"
                    decoration-info="dte_receiver_state in ['pending', 'assigned', 'accepted_objections']"
                    decoration-danger="dte_receiver_state in ['rejected', 'claimed_content', 'claimed_partial', 'claimed_total']"
                />
            </xpath>
        </field>
    </record>
</odoo>
