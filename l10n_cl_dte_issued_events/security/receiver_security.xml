<odoo>
    <record id="rule_receiver_event_company" model="ir.rule">
        <field name="name">DTE receiver events: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_receiver_event" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_receiver_response_company" model="ir.rule">
        <field name="name">DTE receiver responses: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_receiver_response" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
