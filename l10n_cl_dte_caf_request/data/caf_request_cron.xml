<odoo noupdate="1">
    <record id="ir_cron_caf_replenishment_scan" model="ir.cron">
        <field name="name">SII CAF: Evaluate Replenishment Rules</field>
        <field name="model_id" ref="model_l10n_cl_caf_replenishment_rule" />
        <field name="state">code</field>
        <field name="code">model._cron_scan_rules()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_caf_request_process" model="ir.cron">
        <field name="name">SII CAF: Run Automatic Requests</field>
        <field name="model_id" ref="model_l10n_cl_caf_request" />
        <field name="state">code</field>
        <field name="code">model._cron_process_requests()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
    </record>
</odoo>
