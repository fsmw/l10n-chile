#. module: l10n_cl_dte_pos_return
#. odoo-python
#: code:addons/l10n_cl_dte_pos_return/services/pos_line_mapping.py:0
msgid "A POS fiscal detail identity is inconsistent."
msgstr "La identidad de un detalle fiscal de POS es inconsistente."

#. module: l10n_cl_dte_pos_return
#: model:ir.model.constraint,message:l10n_cl_dte_pos_return.constraint_l10n_cl_electronic_document_pos_line_mapping_artifact_unique
msgid "A POS line mapping belongs to one fiscal document."
msgstr "Un mapeo de línea de POS pertenece a un solo documento fiscal."

#. module: l10n_cl_dte_pos_return
#. odoo-python
#: code:addons/l10n_cl_dte_pos_return/models/pos_order.py:0
