msgstr "Un pedido de POS con evidencia fiscal no puede eliminarse."

#. module: l10n_cl_dte_pos_return
#: model:ir.model.constraint,message:l10n_cl_dte_pos_return.constraint_account_move_dte_pos_return_order_unique
msgid "A POS return can have only one accounting credit note."
msgstr "Una devolución de POS solo puede tener una nota de crédito contable."

#. module: l10n_cl_dte_pos_return
#: model:ir.model.constraint,message:l10n_cl_dte_pos_return.constraint_l10n_cl_electronic_document_note_pos_return_order_unique
