<odoo>
    <record id="view_company_form_dte_pos_return" model="ir.ui.view">
        <field name="name">res.company.form.dte.pos.return</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_cl_dte_pos.view_company_form_dte_pos" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dte_sii_settings']/group" position="inside">
                <group string="POS Returns" groups="l10n_cl_dte_core.group_dte_manager">
                    <field name="dte_pos_returns_enabled" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
