<odoo>
    <record id="view_electronic_document_form_pos_return" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.document.form.dte.pos.return</field>
        <field name="model">l10n_cl.electronic.document</field>
        <field name="inherit_id" ref="l10n_cl_dte_core.view_electronic_document_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="POS Return Evidence">
                    <field name="note_pos_return_order_id" />
                    <field name="pos_line_mapping_artifact_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
