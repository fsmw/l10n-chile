<odoo>
    <record id="view_move_form_dte_boleta_issuance" model="ir.ui.view">
        <field name="name">account.move.form.dte.boleta.issuance</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_account.view_move_form_dte_issuance"
        />
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='header_left_group']/div[.//field[@name='partner_id']]"
                position="after"
            >
                <field name="l10n_latam_document_type_id" position="move" />
                <field name="l10n_latam_document_number" position="move" />
                <field
                    name="dte_boleta_payment_method"
                    invisible="dte_document_type_code not in ['39', '41']"
                />
            </xpath>
            <xpath expr="//button[@name='issue_dte']" position="attributes">
                <attribute
                    name="invisible"
                >state != 'posted' or move_type != 'out_invoice' or dte_document_type_code not in ['33', '34', '39', '41']</attribute>
            </xpath>
            <xpath expr="//div[@name='dte_issuance_unavailable']" position="attributes">
                <attribute
                    name="invisible"
                >state != 'posted' or move_type != 'out_invoice' or not dte_document_type_code or dte_document_type_code in ['33', '34', '39', '41'] or dte_document_ids</attribute>
            </xpath>
        </field>
    </record>
</odoo>
