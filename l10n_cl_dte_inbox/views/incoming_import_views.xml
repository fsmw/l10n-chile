<odoo>
    <record id="incoming_import_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.import.list</field>
        <field name="model">l10n_cl.incoming.dte.import</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'invalid'">
                <field name="name" />
                <field name="imported_at" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="environment" />
                <field name="document_count" />
                <field name="imported_count" />
                <field name="duplicate_count" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>
    <record id="incoming_import_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.import.form</field>
        <field name="model">l10n_cl.incoming.dte.import</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="state != 'invalid'"
                    >
                        No DTE was imported from this file. Review the file and document diagnostics below.
                    </div>
                    <div class="alert alert-info" role="alert">
                        Local signature verification checks XML integrity. Certificate trust, signer authorization and SII acceptance are not established by this import.
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="environment" />
                            <field name="channel" />
                            <field name="imported_at" />
                            <field name="actor_id" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="document_count" />
                            <field name="imported_count" />
                            <field name="duplicate_count" />
                            <field name="schema_state" />
                            <field name="schema_name" />
                            <field name="signature_state" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="line_ids" readonly="1">
                                <list
                                    create="0"
                                    edit="0"
                                    delete="0"
                                    decoration-danger="result in ('invalid', 'blocked')"
                                >
                                    <field name="sequence" />
                                    <field name="issuer_vat" />
                                    <field name="document_code" />
                                    <field name="folio" />
                                    <field name="schema_state" />
                                    <field name="signature_state" />
                                    <field name="ted_state" />
                                    <field name="result" />
                                    <field name="incoming_document_id" />
                                </list>
                                <form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="sequence" />
                                        <field name="issuer_vat" />
                                        <field name="document_code" />
                                        <field name="folio" />
                                        <field name="result" />
                                        <field name="schema_name" />
                                        <field name="incoming_document_id" />
                                    </group>
                                    <field
                                        name="diagnostics"
                                        groups="l10n_cl_dte_core.group_dte_manager"
                                    />
                                </form>
                            </field>
                        </page>
                        <page
                            string="File Diagnostics"
                            groups="l10n_cl_dte_core.group_dte_manager"
                        >
                            <field name="diagnostics" />
                        </page>
                        <page
                            string="Original File"
                            groups="l10n_cl_dte_core.group_dte_manager"
                        >
                            <field name="raw_xml" filename="filename" />
                            <field name="filename" />
                            <field name="xml_sha256" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="incoming_import_view_search" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.import.search</field>
        <field name="model">l10n_cl.incoming.dte.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="invalid"
                    string="Invalid Files"
                    domain="[('state', '=', 'invalid')]"
                />
                <filter
                    name="imported"
                    string="Imported Files"
                    domain="[('state', '=', 'imported')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                    <filter
                        name="by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="incoming_import_action" model="ir.actions.act_window">
        <field name="name">Incoming XML Imports</field>
        <field name="res_model">l10n_cl.incoming.dte.import</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
