<odoo>
    <record id="view_email_server_form_dte_intake" model="ir.ui.view">
        <field name="name">fetchmail.server.form.dte.intake</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_form" />
        <field name="arch" type="xml">
            <field name="object_id" position="after">
                <field name="l10n_cl_dte_intake" />
                <field
                    name="l10n_cl_dte_company_id"
                    invisible="not l10n_cl_dte_intake"
                    required="l10n_cl_dte_intake"
                />
                <field
                    name="l10n_cl_dte_user_id"
                    invisible="not l10n_cl_dte_intake"
                    required="l10n_cl_dte_intake"
                />
                <field name="l10n_cl_dte_last_uid" invisible="not l10n_cl_dte_intake" />
            </field>
        </field>
    </record>
</odoo>
