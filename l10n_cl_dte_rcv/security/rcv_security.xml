<odoo>
    <record id="rule_rcv_period_company" model="ir.rule">
        <field name="name">RCV periods: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_rcv_period" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
