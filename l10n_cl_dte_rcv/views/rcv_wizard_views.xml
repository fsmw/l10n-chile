<odoo>
    <record id="view_rcv_csv_import_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.csv.import.wizard.form</field>
        <field name="model">l10n_cl.dte.rcv.csv.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import RCV CSV">
                <div class="alert alert-info" role="alert">
                    Upload the purchase or sales detail CSV of one tax period.
                    Rows that cannot be validated are not imported and are listed
                    on the resulting read, which is then marked as partial.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="operation" />
                    <field name="year" options="{'format': false}" />
                    <field name="month" />
                    <field name="upload" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rcv_csv_import_wizard" model="ir.actions.act_window">
        <field name="name">Import RCV CSV</field>
        <field name="res_model">l10n_cl.dte.rcv.csv.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_csv_import_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="view_rcv_sync_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.sync.wizard.form</field>
        <field name="model">l10n_cl.dte.rcv.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Read RCV from the SII">
                <div class="alert alert-info" role="alert">
                    The read signs in to the SII with the production certificate
                    of the company and runs in the background. Its result is
                    stored as a new read of the period.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="operation" />
                    <field name="year" options="{'format': false}" />
                    <field name="month" />
                </group>
                <footer>
                    <button
                        name="action_sync"
                        type="object"
                        string="Queue Read"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rcv_sync_wizard" model="ir.actions.act_window">
        <field name="name">Read RCV from the SII</field>
        <field name="res_model">l10n_cl.dte.rcv.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_sync_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="view_rcv_year_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.year.wizard.form</field>
        <field name="model">l10n_cl.dte.rcv.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Open RCV Fiscal Year">
                <group>
                    <field name="year" options="{'format': false}" />
                </group>
                <footer>
                    <button
                        name="action_open_year"
                        type="object"
                        string="Open Periods"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rcv_year_wizard" model="ir.actions.act_window">
        <field name="name">Open RCV Fiscal Year</field>
        <field name="res_model">l10n_cl.dte.rcv.year.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_year_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="view_rcv_link_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.link.wizard.form</field>
        <field name="model">l10n_cl.dte.rcv.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link RCV Document">
                <div class="alert alert-info" role="alert" invisible="mode != 'link'">
                    Only journal entries with the document type, folio and RUT of
                    the RCV document can be linked. The link is compared at once
                    and kept by later automatic reconciliations.
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="mode != 'unlink'"
                >
                    The automatic reconciliation will not link this document again
                    until it is linked manually.
                </div>
                <group>
                    <field name="document_id" />
                    <field name="mode" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="candidate_move_ids" invisible="1" />
                    <field name="current_move_id" />
                    <field
                        name="move_id"
                        invisible="mode != 'link'"
                        required="mode == 'link'"
                        domain="[('id', 'in', candidate_move_ids)]"
                        options="{'no_create': True}"
                    />
                    <field
                        name="reason"
                        placeholder="Explain the review behind this decision."
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
