<odoo>
    <record id="view_company_form_dte_rcv" model="ir.ui.view">
        <field name="name">res.company.form.dte.rcv</field>
        <field name="model">res.company</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_core.view_company_form_dte_environment"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dte_sii_settings']" position="inside">
                <group
                    string="Purchase and Sales Register"
                    name="dte_rcv"
                    groups="l10n_cl_dte_core.group_dte_manager"
                >
                    <field name="dte_rcv_daily_read" />
                    <field
                        name="dte_rcv_read_user_id"
                        required="dte_rcv_daily_read"
                        invisible="not dte_rcv_daily_read"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
