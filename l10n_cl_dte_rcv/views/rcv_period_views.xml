<odoo>
    <record id="view_rcv_period_search" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.period.search</field>
        <field name="model">l10n_cl.dte.rcv.period</field>
        <field name="arch" type="xml">
            <search string="RCV Periods">
                <field name="year" />
                <field name="month" />
                <field name="operation" />
                <field name="state" />
                <filter
                    name="not_complete"
                    string="Not Complete"
                    domain="[('state', '!=', 'success')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'month'}"
                    />
                    <filter
                        name="group_year"
                        string="Year"
                        context="{'group_by': 'year'}"
                    />
                    <filter
                        name="group_operation"
                        string="Operation"
                        context="{'group_by': 'operation'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_rcv_period_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.period.list</field>
        <field name="model">l10n_cl.dte.rcv.period</field>
        <field name="arch" type="xml">
            <list
                string="RCV Periods"
                decoration-danger="state == 'failed'"
                decoration-warning="state in ('pending', 'partial')"
                decoration-success="state == 'success'"
            >
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="operation" optional="hide" />
                <field name="state" widget="badge" />
                <field name="last_sync_at" />
                <field name="document_count" />
                <field name="summary_count" />
            </list>
        </field>
    </record>
    <record id="view_rcv_period_kanban" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.period.kanban</field>
        <field name="model">l10n_cl.dte.rcv.period</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="operation">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold" />
                            <field name="state" widget="badge" />
                        </div>
                        <div>
                            <span class="text-muted">Last read: </span>
                            <field name="last_sync_at" />
                        </div>
                        <div>
                            <span class="text-muted">Documents: </span>
                            <field name="document_count" />
                        </div>
                        <div class="mt-2">
                            <button
                                name="action_open_documents"
                                type="object"
                                class="btn btn-primary btn-sm"
                                string="Documents"
                            />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_rcv_period_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.rcv.period.form</field>
        <field name="model">l10n_cl.dte.rcv.period</field>
        <field name="arch" type="xml">
            <form string="RCV Period">
                <header>
                    <button
                        name="action_open_documents"
                        type="object"
                        string="Documents"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="not_synced,pending,partial,success,failed"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="operation" />
                        </group>
                        <group>
                            <field name="year" />
                            <field name="month" />
                            <field name="tax_period" />
                            <field name="last_sync_at" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Current Summary" name="summary">
                            <field name="current_sync_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="summary_ids" readonly="1">
                                <list>
                                    <field name="sii_state" />
                                    <field name="document_type_code" />
                                    <field name="document_type_name" />
                                    <field name="document_count" />
                                    <field name="net_amount" sum="Net" />
                                    <field name="exempt_amount" sum="Exempt" />
                                    <field name="vat_amount" sum="VAT" />
                                    <field name="total_amount" sum="Total" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Reads" name="reads">
                            <field name="sync_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="source" />
                                    <field name="state" widget="badge" />
                                    <field name="finished_at" />
                                    <field name="detail_count" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rcv_period" model="ir.actions.act_window">
        <field name="name">RCV Periods</field>
        <field name="res_model">l10n_cl.dte.rcv.period</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_rcv_period_search" />
        <field name="context">{'search_default_group_month': 1}</field>
    </record>
    <record id="action_rcv_period_year" model="ir.actions.server">
        <field name="name">RCV Periods</field>
        <field name="model_id" ref="model_l10n_cl_dte_rcv_period" />
        <field name="groups_id" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="state">code</field>
        <field name="code">action = model.action_open_year()</field>
    </record>
</odoo>
