<odoo>
    <record id="incoming_received46_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.bill.wizard.received46.form</field>
        <field name="model">l10n_cl.incoming.dte.bill.wizard</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Prepare Customer Invoice">
                <div
                    class="alert alert-info"
                    role="alert"
                >The buyer issued this purchase invoice (DTE 46) and retained the VAT of our sale. It becomes a customer invoice draft that is never issued as our DTE. Local XML validation does not confirm SII acceptance or certificate trust.</div>
                <group>
                    <group>
                        <field name="company_id" />
                        <field name="incoming_document_id" />
                        <field name="partner_id" string="Buyer" />
                        <field name="document_code" />
                        <field name="folio" />
                        <field name="issue_date" />
                        <field name="due_date" />
                    </group>
                    <group>
                        <field name="mode" invisible="1" />
                        <field
                            name="journal_id"
                            options="{'no_create': True}"
                            domain="[('company_id', '=', company_id), ('type', '=', 'sale'), ('l10n_latam_use_documents', '=', True)]"
                        />
                        <field name="accounting_date" />
                        <field name="currency_id" />
                        <field name="source_net" />
                        <field name="source_exempt" />
                        <field name="source_vat" string="Sales VAT (retained)" />
                        <field name="source_total" string="Receivable" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="company_id" column_invisible="True" />
                        <field name="currency_id" column_invisible="True" />
                        <field name="sequence" />
                        <field name="description" />
                        <field name="source_codes" optional="hide" />
                        <field name="source_quantity" />
                        <field name="source_unit_price" />
                        <field name="source_discount_percent" />
                        <field name="source_unit" />
                        <field name="source_exempt" />
                        <field name="source_amount" />
                        <field
                            name="product_id"
                            options="{'no_create': True}"
                            domain="[('sale_ok', '=', True)]"
                        />
                        <field
                            name="account_id"
                            string="Revenue Account"
                            options="{'no_create': True}"
                        />
                        <field
                            name="tax_id"
                            string="Sales VAT"
                            options="{'no_create': True}"
                            domain="[('company_id', '=', company_id), ('type_tax_use', '=', 'sale')]"
                        />
                        <field name="uom_id" options="{'no_create': True}" />
                        <field name="diagnostic_text" optional="show" />
                    </list>
                </field>
                <field name="diagnostic_text" />
                <field name="preview_digest" invisible="1" />
                <field name="has_blockers" invisible="1" />
                <footer>
                    <button
                        name="action_refresh_preview"
                        string="Refresh Preview"
                        type="object"
                    />
                    <button
                        name="action_confirm"
                        string="Confirm Draft"
                        type="object"
                        class="btn-primary"
                        invisible="has_blockers"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
