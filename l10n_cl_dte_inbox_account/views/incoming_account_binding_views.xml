<odoo>
    <record id="incoming_account_binding_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.account.binding.list</field>
        <field name="model">l10n_cl.incoming.dte.account.binding</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="linked_at" />
                <field name="partner_id" />
                <field name="document_code" />
                <field name="folio" />
                <field name="incoming_document_id" />
                <field name="move_id" />
                <field name="move_state" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="incoming_account_binding_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.account.binding.form</field>
        <field name="model">l10n_cl.incoming.dte.account.binding</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_open_move"
                        type="object"
                        string="Vendor Bill"
                    />
                    <button
                        name="action_open_incoming"
                        type="object"
                        string="Incoming DTE"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="partner_id" />
                            <field name="issuer_vat" />
                            <field name="document_code" />
                            <field name="folio" />
                            <field name="issue_date" />
                        </group>
                        <group>
                            <field name="incoming_document_id" />
                            <field name="move_id" />
                            <field name="move_state" />
                            <field name="operation" />
                            <field name="sii_environment" />
                            <field name="linked_at" />
                            <field name="linked_by_id" />
                        </group>
                    </group>
                    <group>
                        <field name="xml_sha256" />
                        <field name="parser_version" />
                    </group>
                    <notebook>
                        <page string="Fiscal Snapshot">
                            <field name="source_snapshot" />
                        </page>
                        <page string="Mapping Snapshot">
                            <field name="mapping_snapshot" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="incoming_account_binding_view_search" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.account.binding.search</field>
        <field name="model">l10n_cl.incoming.dte.account.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="folio" />
                <field name="move_id" />
                <filter
                    name="draft"
                    string="Draft Bills"
                    domain="[('move_state', '=', 'draft')]"
                />
                <filter
                    name="cancel"
                    string="Cancelled Bills"
                    domain="[('move_state', '=', 'cancel')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="incoming_account_binding_action" model="ir.actions.act_window">
        <field name="name">Incoming DTE Vendor Bills</field>
        <field name="res_model">l10n_cl.incoming.dte.account.binding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
