<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_incoming_dte"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-code-o"
                    groups="l10n_cl_dte_inbox_account.group_inbox_account_user"
                    invisible="not dte_inbox_binding_ids"
                >
                    <span>Incoming DTE</span>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Incoming DTE"
                    name="incoming_dte"
                    groups="l10n_cl_dte_inbox_account.group_inbox_account_user"
                    invisible="not dte_inbox_binding_ids"
                >
                    <field name="dte_inbox_binding_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="incoming_document_id" />
                            <field name="xml_sha256" />
                            <field name="linked_at" />
                            <field name="linked_by_id" />
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field
                    name="dte_inbox_line_number"
                    optional="hide"
                    readonly="1"
                    groups="l10n_cl_dte_inbox_account.group_inbox_account_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
