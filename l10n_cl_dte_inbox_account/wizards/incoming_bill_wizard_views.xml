<odoo>
    <record id="incoming_bill_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.bill.wizard.form</field>
        <field name="model">l10n_cl.incoming.dte.bill.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare Vendor Bill">
                <div
                    class="alert alert-info"
                    role="alert"
                >Local XML validation does not confirm SII acceptance or certificate trust. The result will remain a draft.</div>
                <group>
                    <group>
                        <field name="company_id" />
                        <field name="incoming_document_id" />
                        <field name="partner_id" />
                        <field name="document_code" />
                        <field name="folio" />
                        <field name="issue_date" />
                        <field name="due_date" />
                    </group>
                    <group>
                        <field name="mode" />
                        <field
                            name="journal_id"
                            options="{'no_create': True}"
                            invisible="mode != 'create'"
                        />
                        <field name="accounting_date" invisible="mode != 'create'" />
                        <field
                            name="existing_move_id"
                            options="{'no_create': True}"
                            invisible="mode != 'link'"
                        />
                        <field name="candidate_move_ids" invisible="1" />
                        <field name="currency_id" />
                        <field name="source_net" />
                        <field name="source_exempt" />
                        <field name="source_vat" />
                        <field name="source_total" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="company_id" column_invisible="True" />
                        <field name="currency_id" column_invisible="True" />
                        <field name="sequence" />
                        <field name="description" />
                        <field name="source_codes" optional="hide" />
                        <field name="mapping_id" optional="show" />
                        <field name="source_quantity" />
                        <field name="source_unit_price" />
                        <field name="source_discount_percent" />
                        <field name="source_unit" />
                        <field name="source_exempt" />
                        <field name="source_amount" />
                        <field name="product_id" options="{'no_create': True}" />
                        <field name="account_id" options="{'no_create': True}" />
                        <field name="tax_id" options="{'no_create': True}" />
                        <field name="uom_id" options="{'no_create': True}" />
                        <field
                            name="existing_line_id"
                            options="{'no_create': True}"
                            column_invisible="parent.mode != 'link'"
                        />
                        <field name="diagnostic_text" optional="show" />
                    </list>
                </field>
                <field name="diagnostic_text" />
                <field name="preview_digest" invisible="1" />
                <field name="has_blockers" invisible="1" />
                <footer>
                    <button
                        name="action_refresh_preview"
                        string="Refresh Preview"
                        type="object"
                    />
                    <button
                        name="action_confirm"
                        string="Confirm Draft"
                        type="object"
                        class="btn-primary"
                        invisible="has_blockers"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
