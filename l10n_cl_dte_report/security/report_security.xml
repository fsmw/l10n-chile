<odoo>
    <record id="rule_dte_report_sample_company" model="ir.rule">
        <field name="name">DTE report samples: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_report_sample" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dte_report_sample_package_company" model="ir.rule">
        <field name="name">DTE report sample packages: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_report_sample_package" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
