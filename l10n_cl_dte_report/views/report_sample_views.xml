<odoo>
    <record id="dte_report_sample_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.report.sample.list</field>
        <field name="model">l10n_cl.dte.report.sample</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name" />
                <field name="document_id" />
                <field name="document_code" />
                <field name="folio" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
                <field name="pdf_sha256" optional="hide" />
            </list>
        </field>
    </record>
    <record id="dte_report_sample_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.report.sample.form</field>
        <field name="model">l10n_cl.dte.report.sample</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button
                        name="action_generate_pdf"
                        type="object"
                        string="Generar PDF"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_download_pdf"
                        type="object"
                        string="Descargar PDF"
                        invisible="state != 'generated'"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,generated"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'generated'" />
                            <field name="document_id" readonly="1" />
                            <field name="signed_artifact_id" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="document_code" />
                            <field name="folio" />
                            <field name="generated_at" />
                        </group>
                    </group>
                    <group string="Evidencia PDF" invisible="state != 'generated'">
                        <field name="pdf_filename" />
                        <field name="pdf_sha256" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dte_report_sample_search" model="ir.ui.view">
        <field name="name">l10n_cl.dte.report.sample.search</field>
        <field name="model">l10n_cl.dte.report.sample</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="document_id" />
                <field name="folio" />
                <filter
                    name="draft"
                    string="Borrador"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="generated"
                    string="Generado"
                    domain="[('state', '=', 'generated')]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_document_code"
                        string="Tipo de documento"
                        context="{'group_by': 'document_code'}"
                    />
                    <filter
                        name="group_state"
                        string="Estado"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="dte_report_sample_action" model="ir.actions.act_window">
        <field name="name">Muestras impresas DTE</field>
        <field name="res_model">l10n_cl.dte.report.sample</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
    </record>
    <record id="dte_report_sample_package_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.report.sample.package.list</field>
        <field name="model">l10n_cl.dte.report.sample.package</field>
        <field name="arch" type="xml">
            <list create="1" delete="0">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="sample_count" />
                <field name="state" />
                <field name="pdf_sha256" optional="hide" />
            </list>
        </field>
    </record>
    <record id="dte_report_sample_package_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.report.sample.package.form</field>
        <field name="model">l10n_cl.dte.report.sample.package</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button
                        name="action_generate_package"
                        type="object"
                        string="Generar paquete"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_download_pdf"
                        type="object"
                        string="Descargar paquete"
                        invisible="state != 'generated'"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,generated"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state == 'generated'" />
                        <field
                            name="company_id"
                            readonly="state == 'generated'"
                            groups="base.group_multi_company"
                        />
                        <field name="sample_count" />
                    </group>
                    <field
                        name="sample_ids"
                        widget="many2many_tags"
                        domain="[('company_id', '=', company_id), ('state', '=', 'generated')]"
                        readonly="state == 'generated'"
                    />
                    <group string="Paquete generado" invisible="state != 'generated'">
                        <field name="pdf_filename" />
                        <field name="pdf_sha256" />
                        <field name="manifest" widget="json" />
                        <field name="generated_at" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dte_report_sample_package_action" model="ir.actions.act_window">
        <field name="name">Paquetes de muestras</field>
        <field name="res_model">l10n_cl.dte.report.sample.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
    </record>
</odoo>
