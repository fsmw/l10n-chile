<odoo>
    <record id="view_electronic_document_form_report_sample" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.document.form.report.sample</field>
        <field name="model">l10n_cl.electronic.document</field>
        <field name="inherit_id" ref="l10n_cl_dte_core.view_electronic_document_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button
                        name="action_create_print_sample"
                        type="object"
                        string="Crear muestra impresa"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="document_code not in ['33', '34'] or preparation_state != 'queued'"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
