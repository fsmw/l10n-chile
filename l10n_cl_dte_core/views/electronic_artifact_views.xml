<odoo>
    <record id="view_electronic_artifact_list" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.artifact.list</field>
        <field name="model">l10n_cl.electronic.artifact</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="document_id" />
                <field name="role" />
                <field name="sha256" />
                <field name="mimetype" />
                <field name="byte_count" />
                <field name="created_at" />
            </list>
        </field>
    </record>
    <record id="view_electronic_artifact_form" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.artifact.form</field>
        <field name="model">l10n_cl.electronic.artifact</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="document_id" readonly="1" />
                        <field name="role" readonly="1" />
                        <field name="sha256" readonly="1" />
                        <field name="mimetype" readonly="1" />
                        <field name="encoding" readonly="1" />
                        <field name="byte_count" readonly="1" />
                        <field name="producer_version" readonly="1" />
                        <field name="created_at" readonly="1" />
                        <field
                            name="content"
                            readonly="1"
                            groups="l10n_cl_dte_core.group_dte_manager"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
