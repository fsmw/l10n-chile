<odoo>
    <record id="group_dte_user" model="res.groups">
        <field name="name">DTE User</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
    </record>
    <record id="group_dte_manager" model="res.groups">
        <field name="name">DTE Manager</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field name="implied_ids" eval="[(4, ref('group_dte_user'))]" />
    </record>
    <record id="rule_electronic_document_company" model="ir.rule">
        <field name="name">DTE documents: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_electronic_document" />
        <field name="groups" eval="[(4, ref('group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_electronic_artifact_company" model="ir.rule">
        <field name="name">DTE evidence: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_electronic_artifact" />
        <field name="groups" eval="[(4, ref('group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_electronic_event_company" model="ir.rule">
        <field name="name">DTE events: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_electronic_event" />
        <field name="groups" eval="[(4, ref('group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
