<odoo>
    <record id="view_company_form_dte_rcv_inbox" model="ir.ui.view">
        <field name="name">res.company.form.dte.rcv.inbox</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_cl_dte_rcv.view_company_form_dte_rcv" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='dte_rcv']" position="inside">
                <field name="dte_rcv_auto_draft" />
                <field
                    name="dte_rcv_draft_user_id"
                    required="dte_rcv_auto_draft"
                    invisible="not dte_rcv_auto_draft"
                />
            </xpath>
        </field>
    </record>
</odoo>
