<odoo>
    <record id="rule_dte_assignment_company" model="ir.rule">
        <field name="name">DTE assignments: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_assignment" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dte_assignment_evidence_company" model="ir.rule">
        <field name="name">DTE assignment evidence: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_assignment_evidence" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dte_assignment_attempt_company" model="ir.rule">
        <field name="name">DTE assignment attempts: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_assignment_attempt" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
