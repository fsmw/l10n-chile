<odoo>
    <record id="view_move_form_dte_assignment" model="ir.ui.view">
        <field name="name">account.move.form.dte.assignment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_dte_assignments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-handshake-o"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="dte_assignment_state == 'none' and not dte_assignment_ids"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Factoring</span>
                        <field
                            name="dte_assignment_state"
                            class="o_stat_value"
                            readonly="1"
                        />
                    </div>
                </button>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="action_create_dte_assignment"
                    type="object"
                    string="Assign to Factoring"
                    groups="l10n_cl_dte_core.group_dte_manager"
                    invisible="not dte_assignment_available"
                />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field
                    name="dte_assignment_ids"
                    invisible="1"
                    groups="l10n_cl_dte_core.group_dte_user"
                />
                <field
                    name="dte_assignment_available"
                    invisible="1"
                    groups="l10n_cl_dte_core.group_dte_user"
                />
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
                <div
                    name="dte_assignment_notice"
                    class="alert alert-info"
                    role="alert"
                    colspan="2"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="dte_assignment_state == 'none'"
                >
                    Receivable assigned to
                    <field name="dte_assignee_id" class="oe_inline" readonly="1" />
                    (<field
                    name="dte_assignment_state"
                    class="oe_inline"
                    readonly="1"
                />,
                    TrackID <field
                    name="dte_assignment_track_id"
                    class="oe_inline"
                    readonly="1"
                />).
                </div>
            </xpath>
        </field>
    </record>
</odoo>
