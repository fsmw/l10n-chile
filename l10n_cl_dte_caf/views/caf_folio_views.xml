<odoo>
    <record id="view_caf_folio_list" model="ir.ui.view">
        <field name="name">l10n_cl.caf.folio.list</field>
        <field name="model">l10n_cl.caf.folio</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="authorization_id" />
                <field name="number" />
                <field name="document_id" />
                <field name="state" />
                <field name="reserved_at" />
                <field name="reserved_by" />
            </list>
        </field>
    </record>
    <record id="action_caf_folio" model="ir.actions.act_window">
        <field name="name">Reserved Folios</field>
        <field name="res_model">l10n_cl.caf.folio</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
