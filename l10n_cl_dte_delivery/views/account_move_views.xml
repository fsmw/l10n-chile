<odoo>
    <record id="view_move_form_dte_delivery" model="ir.ui.view">
        <field name="name">account.move.form.dte.delivery</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_account.view_move_form_dte_issuance"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='issue_dte']" position="after">
                <button
                    name="action_send_dte_to_customer"
                    type="object"
                    string="Send DTE to Customer"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="dte_document_count == 0 or dte_delivery_state == 'sent'"
                />
            </xpath>
            <xpath expr="//div[@name='dte_issuance_unavailable']" position="after">
                <field
                    name="dte_delivery_state"
                    invisible="dte_document_count == 0"
                    groups="l10n_cl_dte_core.group_dte_user"
                />
                <field
                    name="dte_delivery_message"
                    invisible="not dte_delivery_message"
                    groups="l10n_cl_dte_core.group_dte_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
