<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.l10n_cl_dte_website_sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="inside">
                <field
                    name="l10n_cl_dte_document_kind"
                    invisible="country_code != 'CL' or not website_id"
                />
                <field
                    name="l10n_cl_dte_receiver_vat"
                    invisible="l10n_cl_dte_document_kind != 'factura'"
                />
                <field
                    name="l10n_cl_dte_receiver_name"
                    invisible="l10n_cl_dte_document_kind != 'factura'"
                />
                <field
                    name="l10n_cl_dte_receiver_activity"
                    invisible="l10n_cl_dte_document_kind != 'factura'"
                />
            </xpath>
        </field>
    </record>
</odoo>
