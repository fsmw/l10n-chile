<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_dte_caf_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.list</field>
        <field name="model">l10n_cl.dte.caf</field>
        <field name="arch" type="xml">
            <list
                string="CAF y folios"
                create="false"
                decoration-success="state == 'in_use'"
                decoration-muted="state in ('exhausted', 'disabled')"
            >
                <field name="name" string="Archivo CAF" />
                <field
                    name="company_id"
                    string="Compañía"
                    groups="base.group_multi_company"
                />
                <field name="document_type_id" string="Tipo de documento" />
                <field name="start_nb" string="Folio inicial" />
                <field name="final_nb" string="Folio final" />
                <field name="next_folio" string="Próximo folio" />
                <field name="state" string="Estado CAF" widget="badge" />
            </list>
        </field>
    </record>
    <record id="view_dte_caf_search" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.search</field>
        <field name="model">l10n_cl.dte.caf</field>
        <field name="arch" type="xml">
            <search string="Buscar CAF">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="document_type_id" />
                <filter
                    name="caf_in_use"
                    string="Vigentes"
                    domain="[('state', '=', 'in_use')]"
                />
                <filter
                    name="caf_spent"
                    string="Agotados"
                    domain="[('state', '=', 'exhausted')]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_company"
                        string="Compañía"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_document_type"
                        string="Tipo de documento"
                        context="{'group_by': 'document_type_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Estado"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_dte_caf_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.form</field>
        <field name="model">l10n_cl.dte.caf</field>
        <field name="arch" type="xml">
            <form string="CAF" create="false" edit="false">
                <header>
                    <button
                        name="action_enable"
                        type="object"
                        string="Activar"
                        class="oe_highlight"
                        groups="l10n_cl_dte_sii.group_dte_manager"
                        invisible="state not in ('uploaded', 'disabled')"
                    />
                    <button
                        name="action_disable"
                        type="object"
                        string="Desactivar"
                        groups="l10n_cl_dte_sii.group_dte_manager"
                        invisible="state != 'in_use'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="uploaded,in_use,exhausted,disabled"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Archivo CAF" />
                            <field
                                name="company_id"
                                string="Compañía"
                                groups="base.group_multi_company"
                            />
                            <field name="document_type_id" string="Tipo de documento" />
                        </group>
                        <group string="Rango autorizado">
                            <field
                                name="start_nb"
                                string="Folio inicial"
                                readonly="1"
                            />
                            <field name="final_nb" string="Folio final" readonly="1" />
                            <field
                                name="next_folio"
                                string="Próximo folio"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <group string="Archivo CAF">
                        <field
                            name="caf_data"
                            widget="binary"
                            filename="name"
                            groups="l10n_cl_dte_sii.group_dte_manager"
                            readonly="1"
                        />
                        <div class="alert alert-warning" role="alert">
                            El archivo CAF se procesa al importarlo. Revise emisor, tipo y rango autorizados antes de activarlo.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dte_caf" model="ir.actions.act_window">
        <field name="name">CAF y folios</field>
        <field name="res_model">l10n_cl.dte.caf</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dte_caf_search" />
        <field name="context">{'search_default_caf_in_use': 1}</field>
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >Cargue el archivo CAF autorizado por el SII</p>
            <p
            >El CAF habilita folios para emitir DTE. Verifique compañía, tipo y rango antes de activarlo.</p>
        </field>
    </record>
    <record id="view_dte_caf_upload_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.upload.form</field>
        <field name="model">l10n_cl.dte.caf.upload</field>
        <field name="arch" type="xml">
            <form string="Importar CAF del SII">
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="upload_filename" invisible="1" />
                    <field
                        name="upload_data"
                        filename="upload_filename"
                        widget="binary"
                    />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar CAF"
                        class="oe_highlight"
                        groups="l10n_cl_dte_sii.group_dte_manager"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dte_caf_upload" model="ir.actions.act_window">
        <field name="name">Importar CAF</field>
        <field name="res_model">l10n_cl.dte.caf.upload</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dte_caf_upload_form" />
        <field name="target">new</field>
    </record>
</odoo>
