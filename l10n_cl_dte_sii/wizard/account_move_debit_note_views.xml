<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_debit_note_dte_sii" model="ir.ui.view">
        <field name="name">account.move.debit.note.form.dte.sii</field>
        <field name="model">account.debit.note</field>
        <field name="inherit_id" ref="account_debit_note.view_account_debit_note"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="Referencia DTE" invisible="country_code != 'CL'">
                    <field name="country_code" invisible="1"/>
                    <field name="l10n_cl_edi_reference_doc_code" required="country_code == 'CL'"/>
                    <group invisible="l10n_cl_edi_reference_doc_code != '2'">
                        <field name="l10n_cl_original_text" required="l10n_cl_edi_reference_doc_code == '2'"/>
                        <field name="l10n_cl_corrected_text" required="l10n_cl_edi_reference_doc_code == '2'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
