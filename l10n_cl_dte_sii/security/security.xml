<odoo>
    <record id="group_dte_user" model="res.groups">
        <field name="name">DTE SII User</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>
    <record id="group_dte_manager" model="res.groups">
        <field name="name">DTE SII Manager</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field
            name="implied_ids"
            eval="[(4, ref('l10n_cl_dte_sii.group_dte_user')), (4, ref('account.group_account_manager'))]"
        />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>
    <record id="rule_dte_caf_company" model="ir.rule">
        <field name="name">DTE CAF multi-company</field>
        <field name="model_id" ref="model_l10n_cl_dte_caf" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_dte_sii.group_dte_user'))]" />
    </record>
    <record id="rule_dte_receiver_delivery_company" model="ir.rule">
        <field name="name">DTE receiver delivery by company</field>
        <field name="model_id" ref="model_l10n_cl_dte_receiver_delivery" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_dte_sii.group_dte_user'))]" />
    </record>
    <record id="rule_dte_invoice_reference_company" model="ir.rule">
        <field name="name">DTE references by allowed company</field>
        <field name="model_id" ref="model_l10n_cl_account_invoice_reference" />
        <field name="domain_force">[('move_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>
</odoo>
