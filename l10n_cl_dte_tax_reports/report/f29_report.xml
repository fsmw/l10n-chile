<odoo>
    <record id="action_report_f29" model="ir.actions.report">
        <field name="name">F29 Worksheet</field>
        <field name="model">l10n_cl.f29.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cl_dte_tax_reports.report_f29</field>
        <field name="report_file">l10n_cl_dte_tax_reports.report_f29</field>
        <field name="binding_type">report</field>
    </record>
    <template id="report_f29">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h4>F29 Worksheet</h4>
                        <p>
                            <span t-field="doc.company_id.name" />:
                            <span t-field="doc.date_from" /> -
                            <span t-field="doc.date_to" />
                        </p>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Section</th>
                                    <th>Concept</th>
                                    <th>Box</th>
                                    <th class="text-end">Documents</th>
                                    <th>Box</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr
                                    t-foreach="doc.line_ids"
                                    t-as="line"
                                    t-att-class="'fw-bold' if line.line_type == 'total' else ''"
                                >
                                    <td>
                                        <span t-field="line.section" />
                                    </td>
                                    <td t-out="line.name" />
                                    <td t-out="line.count_code" />
                                    <td class="text-end">
                                        <t t-if="line.count_code" t-out="line.count" />
                                    </td>
                                    <td t-out="line.amount_code" />
                                    <td class="text-end">
                                        <span
                                            t-field="line.amount"
                                            t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="small text-muted">
                            Worksheet computed from posted journal entries. Check the
                            amounts against the Purchase and Sales Register (RCV)
                            before filing the F29 form.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
