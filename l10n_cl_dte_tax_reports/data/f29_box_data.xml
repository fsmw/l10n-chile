<odoo noupdate="1">
    <record id="f29_box_sale_invoice" model="l10n_cl.f29.box">
        <field name="name">Invoices issued</field>
        <field name="sequence">10</field>
        <field name="section">sale</field>
        <field name="move_scope">sale</field>
        <field name="count_code">503</field>
        <field name="amount_code">502</field>
        <field
            name="document_type_ids"
            eval="[Command.set([ref('l10n_cl.dc_a_f_dte'), ref('l10n_cl.dc_a_f_dtn')])]"
        />
        <field name="amount_source">tax</field>
        <field name="tag_names">IVA Debito Fiscal</field>
        <field name="sign">1</field>
        <field name="total_effect">debit</field>
    </record>
