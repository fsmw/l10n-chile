<odoo>
    <record id="view_certification_set_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.set.list</field>
        <field name="model">l10n_cl.dte.certification.set</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="source_filename" />
                <field name="source_byte_count" />
                <field name="create_date" />
                <field name="imported_by" />
            </list>
        </field>
    </record>
    <record id="view_certification_set_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.set.form</field>
        <field name="model">l10n_cl.dte.certification.set</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button
                        name="action_parse_source"
                        type="object"
                        string="Analyze SET"
                        class="oe_highlight"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_materialize_cases"
                        type="object"
                        string="Create Case Snapshots"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="case_count or not parsed_structure"
                    />
                    <button
                        name="action_interpret_cases"
                        type="object"
                        string="Interpret Case Instructions"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="not case_count"
                    />
                    <button
                        name="action_reinterpret_cases"
                        type="object"
                        string="Reinterpret Outdated Cases"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="case_outdated_count == 0"
                    />
                    <button
                        name="action_check_case_coverage"
                        type="object"
                        string="Check Case Coverage"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="not case_count"
                    />
                    <field
                        name="parse_state"
                        widget="statusbar"
                        statusbar_visible="pending,parsed,blocked"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                            <field name="source_filename" />
                        </group>
                        <group>
                            <field name="source_byte_count" />
                            <field name="source_digest" />
                            <field name="create_date" />
                            <field name="imported_by" />
                        </group>
                    </group>
                    <group groups="l10n_cl_dte_core.group_dte_manager">
                        <field name="source_file" filename="source_filename" />
                    </group>
                    <group string="Structural analysis">
                        <field name="parser_version" />
                        <field name="parse_message" />
                        <field name="parsed_structure" widget="json" />
                    </group>
                    <group
                        string="Case coverage"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    >
                        <field name="case_coverage_state" widget="statusbar" />
                        <field name="case_count" />
                        <field name="case_interpreted_count" />
                        <field name="case_review_required_count" />
                        <field name="case_unsupported_count" />
                        <field name="case_pending_count" />
                    </group>
                    <group string="Cases" groups="l10n_cl_dte_core.group_dte_manager">
                        <field name="case_count" />
                        <field name="case_ids" nolabel="1" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="sequence" />
                                <field name="attention_number" />
                                <field name="case_identifier" />
                                <field name="document_code" />
                                <field name="interpretation_state" />
                                <field name="interpretation_version" optional="hide" />
                                <field name="source_start_line" />
                                <field name="source_end_line" />
                            </list>
                            <form create="false" edit="false" delete="false">
                                <sheet>
                                    <group>
                                        <field name="case_identifier" />
                                        <field name="attention_number" />
                                        <field name="sequence" />
                                        <field name="section_sequence" />
                                        <field name="document_code" />
                                        <field name="interpretation_state" />
                                        <field name="source_digest" />
                                        <field name="source_start_line" />
                                        <field name="source_end_line" />
                                    </group>
                                    <group>
                                        <field name="instruction_text" />
                                        <field name="diagnostics" widget="json" />
                                        <field name="interpretation_version" />
                                        <field name="interpretation" widget="json" />
                                    </group>
                                    <group string="Interpreted details">
                                        <field name="line_ids" nolabel="1" readonly="1">
                                            <list
                                                create="false"
                                                edit="false"
                                                delete="false"
                                            >
                                                <field name="sequence" />
                                                <field name="source_line" />
                                                <field name="item_name" />
                                                <field name="quantity" />
                                                <field name="unit_price" />
                                                <field name="discount_percent" />
                                                <field name="unit_of_measure" />
                                                <field
                                                    name="interpretation_version"
                                                    optional="hide"
                                                />
                                            </list>
                                        </field>
                                    </group>
                                    <group string="Interpreted facts">
                                        <group>
                                            <field name="global_discount_percent" />
                                            <field name="global_discount_source_line" />
                                            <field name="reference_case_identifier" />
                                            <field name="referenced_case_id" />
                                            <field name="reference_source_line" />
                                            <field name="note_operation" />
                                        </group>
                                        <group>
                                            <field name="reference_reason" />
                                            <field name="reference_code" />
                                            <field name="reference_code_source_line" />
                                            <field
                                                name="reference_reason_source_line"
                                            />
                                            <field
                                                name="text_correction"
                                                widget="json"
                                            />
                                        </group>
                                    </group>
                                    <group string="Interpretation history">
                                        <field
                                            name="interpretation_history_ids"
                                            nolabel="1"
                                            readonly="1"
                                        >
                                            <list
                                                create="false"
                                                edit="false"
                                                delete="false"
                                            >
                                                <field name="sequence" />
                                                <field name="occurred_at" />
                                                <field name="actor_id" />
                                                <field
                                                    name="from_interpreter_version"
                                                />
                                                <field name="to_interpreter_version" />
                                            </list>
                                            <form
                                                create="false"
                                                edit="false"
                                                delete="false"
                                            >
                                                <sheet>
                                                    <group>
                                                        <field name="sequence" />
                                                        <field name="occurred_at" />
                                                        <field name="actor_id" />
                                                        <field
                                                            name="from_interpreter_version"
                                                        />
                                                        <field
                                                            name="to_interpreter_version"
                                                        />
                                                    </group>
                                                    <group>
                                                        <field
                                                            name="previous_interpretation"
                                                            widget="json"
                                                        />
                                                        <field
                                                            name="new_interpretation"
                                                            widget="json"
                                                        />
                                                    </group>
                                                </sheet>
                                            </form>
                                        </field>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_certification_set" model="ir.actions.act_window">
        <field name="name">Certification Set Sources</field>
        <field name="res_model">l10n_cl.dte.certification.set</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
