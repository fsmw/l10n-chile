<odoo>
    <record id="view_certification_set_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.set.list</field>
        <field name="model">l10n_cl.dte.certification.set</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="source_filename" />
                <field name="source_byte_count" />
                <field name="create_date" />
                <field name="imported_by" />
            </list>
        </field>
    </record>
    <record id="view_certification_set_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.set.form</field>
        <field name="model">l10n_cl.dte.certification.set</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                            <field name="source_filename" />
                        </group>
                        <group>
                            <field name="source_byte_count" />
                            <field name="source_digest" />
                            <field name="create_date" />
                            <field name="imported_by" />
                        </group>
                    </group>
                    <group groups="l10n_cl_dte_core.group_dte_manager">
                        <field name="source_file" filename="source_filename" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_certification_set" model="ir.actions.act_window">
        <field name="name">Certification Set Sources</field>
        <field name="res_model">l10n_cl.dte.certification.set</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
