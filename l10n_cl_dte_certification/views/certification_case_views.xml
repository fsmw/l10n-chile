<odoo>
    <record id="certification_case_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.case.list</field>
        <field name="model">l10n_cl.dte.certification.case</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="case_identifier" />
                <field name="set_id" />
                <field name="document_code" />
                <field name="partner_id" />
                <field name="readiness" />
            </list>
        </field>
    </record>
    <record id="certification_case_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.case.form</field>
        <field name="model">l10n_cl.dte.certification.case</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <field name="can_map" invisible="1" />
                    <field name="can_correct_receiver_activity" invisible="1" />
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="set_id" readonly="1" />
                        <field name="case_identifier" readonly="1" />
                        <field name="document_code" readonly="1" />
                        <field
                            name="note_operation"
                            readonly="1"
                            invisible="document_code not in ('56', '61')"
                        />
                        <field
                            name="reference_code"
                            readonly="1"
                            invisible="document_code not in ('56', '61')"
                        />
                        <field
                            name="reference_case_identifier"
                            readonly="1"
                            invisible="document_code not in ('56', '61')"
                        />
                        <field
                            name="reference_reason"
                            readonly="1"
                            invisible="document_code not in ('56', '61')"
                        />
                        <field
                            name="global_discount_percent"
                            readonly="1"
                            invisible="not global_discount_percent"
                        />
                        <field
                            name="sii_reference_reason"
                            readonly="1"
                            invisible="note_operation != 'text'"
                        />
                        <button
                            name="action_generate_test_receiver_activities"
                            type="object"
                            string="Generate Test Activities"
                            invisible="not can_correct_receiver_activity"
                            groups="l10n_cl_dte_core.group_dte_manager"
                        />
                        <field
                            name="synthetic_receiver_activity_label"
                            invisible="not synthetic_receiver_activity_label"
                        />
                        <field name="partner_id" readonly="not can_map" />
                        <field name="readiness" readonly="1" />
                    </group>
                    <field name="instruction_text" readonly="1" />
                    <field name="line_ids" readonly="not can_map">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" readonly="1" />
                            <field name="name" readonly="1" />
                            <field name="quantity_text" readonly="1" />
                            <field name="unit_price_text" readonly="1" />
                            <field name="discount_percent_text" readonly="1" />
                            <field name="exempt" readonly="1" />
                            <field name="product_id" />
                        </list>
                    </field>
                    <field name="diagnostics" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
