<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="certification_completion_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.completion.wizard.form</field>
        <field name="model">l10n_cl.dte.certification.completion.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Certification Set Data">
                <field name="set_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="blocking_count" invisible="1" />
                <field name="synthetic_count" invisible="1" />
                <field name="review_digest" invisible="1" />
                <field name="target_mode" invisible="1" />
                <div class="alert alert-info" role="alert">
                    Existing contacts are assigned automatically to missing invoice receivers. Each invoice uses a different RUT, and notes inherit the receiver of their referenced document. Review the assignments and resolve any remaining preparation issues.
                </div>
                <group>
                    <field name="blocking_count" string="Pending Issues" readonly="1" />
                </group>
                <field name="case_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0">
                        <field name="case_identifier" />
                        <field name="document_code" />
                        <field name="reference_case_identifier" optional="hide" />
                        <field name="partner_id" />
                        <field name="readiness" />
                    </list>
                </field>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sequence" readonly="1" optional="hide" />
                        <field name="case_id" />
                        <field name="case_line_id" optional="hide" />
                        <field name="diagnostic_code" column_invisible="1" />
                        <field name="diagnostic_message" />
                        <field name="target_field" optional="hide" />
                        <field name="severity" />
                        <field name="source" optional="hide" />
                        <field name="suggested_value" optional="hide" />
                        <field
                            name="partner_id"
                            readonly="target_field != 'partner_id'"
                            options="{'no_create': True}"
                        />
                        <field
                            name="product_id"
                            readonly="target_field != 'product_id'"
                            options="{'no_create': True}"
                        />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh Analysis"
                        class="btn-secondary"
                    />
                    <button
                        name="action_apply_official_review"
                        type="object"
                        string="Prepare Cases for Generation"
                        class="btn-primary"
                    />
                    <button
                        name="action_generate_test_receiver_activities"
                        type="object"
                        string="Generate Test Activities"
                        class="btn-secondary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
