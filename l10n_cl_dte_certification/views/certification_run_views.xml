<odoo>
    <record id="view_certification_run_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.run.form</field>
        <field name="model">l10n_cl.dte.certification.run</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,generated,prepared,partial,blocked"
                    />
                    <button
                        name="action_open_generation_wizard"
                        type="object"
                        string="Generate Draft Documents"
                        class="oe_highlight"
                        invisible="state not in ['draft', 'partial']"
                    />
                    <button
                        name="action_prepare_dte"
                        type="object"
                        string="Prepare Signed DTEs"
                        invisible="state not in ['generated', 'partial', 'prepared']"
                    />
                    <button
                        name="action_export_envelope"
                        type="object"
                        string="Export Certification Envelope"
                        invisible="state != 'prepared'"
                    />
                    <button
                        name="action_send_certification_envelope"
                        type="object"
                        string="Send Certification Envelope to SII"
                        invisible="state != 'prepared' or not envelope_xml or sii_submission_id"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_open_sii_submission"
                        type="object"
                        string="Open SII Transmission"
                        invisible="not sii_submission_id"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="set_id" />
                            <field name="revision" />
                            <field name="emission_date" />
                            <field name="created_by" />
                        </group>
                        <group>
                            <field name="company_id" />
                            <field name="set_digest" />
                            <field name="snapshot_digest" />
                            <field name="line_count" />
                        </group>
                    </group>
                    <group
                        string="Offline Envelope Evidence"
                        invisible="not envelope_xml"
                    >
                        <field
                            name="envelope_xml"
                            filename="envelope_filename"
                            widget="binary"
                        />
                        <field name="envelope_filename" />
                        <field name="envelope_digest" />
                        <field name="envelope_built_at" />
                        <field name="sii_submission_id" />
                    </group>
                    <group string="Frozen Cases">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="sequence" />
                                <field name="case_identifier" />
                                <field name="document_code" />
                                <field name="generation_state" />
                                <field name="preparation_state" />
                                <field name="document_id" />
                                <field name="move_id" />
                                <field name="partner_id" optional="hide" />
                                <field name="generation_message" optional="hide" />
                                <field name="preparation_message" optional="hide" />
                                <field name="referenced_line_id" />
                                <field name="snapshot_digest" optional="hide" />
                            </list>
                            <form create="false" edit="false" delete="false">
                                <sheet>
                                    <group>
                                        <field name="sequence" />
                                        <field name="case_id" />
                                        <field name="case_identifier" />
                                        <field name="document_code" />
                                        <field name="generation_state" />
                                        <field name="preparation_state" />
                                        <field name="document_id" />
                                        <field name="move_id" />
                                        <field name="partner_id" />
                                        <field name="generation_message" />
                                        <field name="preparation_message" />
                                        <field name="referenced_line_id" />
                                        <field name="source_digest" />
                                        <field name="snapshot_digest" />
                                    </group>
                                    <field name="snapshot" widget="json" />
                                </sheet>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_certification_run_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.run.wizard.form</field>
        <field name="model">l10n_cl.dte.certification.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Certification Execution">
                <group>
                    <field name="set_id" />
                    <field name="case_ids" nolabel="1">
                        <list create="false" delete="true" editable="bottom">
                            <field name="sequence" readonly="1" />
                            <field name="case_identifier" readonly="1" />
                            <field name="document_code" readonly="1" />
                            <field name="interpretation_state" readonly="1" />
                            <field name="referenced_case_id" readonly="1" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_create_execution"
                        type="object"
                        string="Create Execution"
                        class="oe_highlight"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_certification_generation_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.generation.wizard.form</field>
        <field name="model">l10n_cl.dte.certification.generation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Certification Drafts">
                <group>
                    <field name="run_id" />
                    <field name="company_id" invisible="1" />
                    <field name="journal_id" />
                    <field name="income_account_id" />
                    <field name="vat_tax_id" />
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="false" delete="true" editable="bottom">
                        <field name="sequence" readonly="1" />
                        <field name="case_identifier" readonly="1" />
                        <field name="document_code" readonly="1" />
                        <field name="selected" />
                        <field name="partner_id" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generate Drafts"
                        class="oe_highlight"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
