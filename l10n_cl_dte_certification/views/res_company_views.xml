<odoo>
    <record id="res_company_view_form_certification" model="ir.ui.view">
        <field name="name">res.company.form.dte.certification</field>
        <field name="model">res.company</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_core.view_company_form_dte_environment"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dte_sii_settings']" position="inside">
                <group
                    string="Certification"
                    name="dte_certification_configuration"
                    invisible="dte_sii_environment != 'certification'"
                    groups="l10n_cl_dte_core.group_dte_manager"
                >
                    <group>
                        <field name="dte_sii_sender_vat" />
                        <field name="dte_certification_resolution_date" />
                        <field
                            name="dte_certification_journal_id"
                            domain="[('company_id', '=', id), ('type', '=', 'sale')]"
                        />
                    </group>
                    <group>
                        <field
                            name="dte_certification_vat_tax_id"
                            domain="[('company_id', '=', id), ('type_tax_use', '=', 'sale'), ('amount', '=', 19)]"
                        />
                        <field
                            name="dte_certification_exempt_tax_id"
                            domain="[('company_id', '=', id), ('type_tax_use', '=', 'sale'), ('amount', '=', 0)]"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
