<odoo>
    <record id="certification_caf_import_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.caf.import.wizard.form</field>
        <field name="model">l10n_cl.dte.certification.caf.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Certification CAF">
                <group>
                    <field name="set_id" />
                    <field name="caf_file" filename="caf_filename" />
                    <field name="caf_filename" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Validate and Add"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
