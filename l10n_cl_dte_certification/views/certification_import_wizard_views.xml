<odoo>
    <record id="view_certification_import_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.certification.import.wizard.form</field>
        <field name="model">l10n_cl.dte.certification.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Original SII Set">
                <group>
                    <field name="company_id" />
                    <field name="source_file" filename="source_filename" />
                    <field name="source_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_certification_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Original SII Set</field>
        <field name="res_model">l10n_cl.dte.certification.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
