<odoo noupdate="1">
    <record id="certification_caf_request_process_cron" model="ir.cron">
        <field name="name">Process Certification CAF Requests</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_caf_request" />
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
    <record id="certification_caf_request_recovery_cron" model="ir.cron">
        <field name="name">Recover Stale Certification CAF Requests</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_caf_request" />
        <field name="state">code</field>
        <field name="code">model._cron_recover_dispatching()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
