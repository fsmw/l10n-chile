<odoo>
    <record id="certification_process_rule_company" model="ir.rule">
        <field name="name">Certification process: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_process" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="certification_process_stage_rule_company" model="ir.rule">
        <field name="name">Certification stage: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_process_stage" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="certification_process_requirement_rule_company" model="ir.rule">
        <field name="name">Certification requirement: allowed companies</field>
        <field
            name="model_id"
            ref="model_l10n_cl_dte_certification_process_requirement"
        />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="certification_evidence_rule_company" model="ir.rule">
        <field name="name">Certification evidence: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_evidence" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="certification_event_rule_company" model="ir.rule">
        <field name="name">Certification event: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_process_event" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
