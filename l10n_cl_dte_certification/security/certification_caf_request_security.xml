<odoo>
    <record id="certification_caf_request_rule_manager" model="ir.rule">
        <field name="name">Certification CAF requests by company</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_caf_request" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_manager'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="certification_caf_request_line_rule_manager" model="ir.rule">
        <field name="name">Certification CAF request lines by company</field>
        <field name="model_id" ref="model_l10n_cl_dte_certification_caf_request_line" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_manager'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
