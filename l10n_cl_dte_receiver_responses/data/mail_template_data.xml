<odoo noupdate="1">
    <record id="mail_template_exchange_response" model="mail.template">
        <field name="name">DTE: Exchange Response to Supplier</field>
        <field name="model_id" ref="model_l10n_cl_incoming_dte_exchange" />
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field
            name="subject"
        >{{ object.company_id.name }} - {{ object.filename or 'DTE exchange response' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>
        Attached is the signed electronic exchange response
        <t t-out="object.filename or ''" />
        that <t t-out="object.company_id.name or ''" />
        (RUT <t t-out="object.responder_vat or ''" />) sends for the
        electronic tax documents issued by RUT
        <t t-out="object.supplier_vat or ''" />.
    </p>
            </div>
        </field>
        <field name="auto_delete" eval="False" />
    </record>
</odoo>
