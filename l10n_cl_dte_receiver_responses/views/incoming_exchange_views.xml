<odoo>
    <record id="incoming_exchange_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.exchange.list</field>
        <field name="model">l10n_cl.incoming.dte.exchange</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="kind" />
                <field name="supplier_vat" />
                <field name="recipient_email" />
                <field name="signed_at" />
                <field name="last_sent_at" />
                <field name="send_count" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'sent'"
                    decoration-info="state == 'queued'"
                    decoration-danger="state == 'failed'"
                />
            </list>
        </field>
    </record>
    <record id="incoming_exchange_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.exchange.form</field>
        <field name="model">l10n_cl.incoming.dte.exchange</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        class="btn-primary"
                        invisible="state not in ('signed', 'failed')"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_resend"
                        type="object"
                        string="Resend"
                        invisible="state == 'signed'"
                        confirm="Email the same signed XML to the supplier again?"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="signed,queued,sent"
                    />
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Since Law 20.956 the legal acceptance or claim of a DTE is the SII registry action. This signed XML is the commercial exchange response emailed to the supplier.
                    </div>
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="state != 'failed'"
                    >
                        <field name="send_error" />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="kind" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="environment" />
                            <field name="trigger" />
                            <field name="import_id" invisible="not import_id" />
                            <field
                                name="registry_response_id"
                                invisible="not registry_response_id"
                            />
                        </group>
                        <group>
                            <field name="responder_vat" />
                            <field name="supplier_vat" />
                            <field name="signer_vat" />
                            <field
                                name="recipient_email"
                                readonly="state not in ('signed', 'failed')"
                            />
                            <field name="signed_at" />
                            <field name="last_sent_at" />
                            <field name="send_count" />
                            <field name="mail_id" groups="base.group_system" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="incoming_document_id" />
                                    <field name="document_code" />
                                    <field name="folio" />
                                    <field name="issuer_vat" />
                                    <field name="issue_date" />
                                    <field name="total_amount" />
                                    <field name="status_code" />
                                    <field name="gloss" />
                                </list>
                            </field>
                        </page>
                        <page string="Signed XML" name="xml">
                            <group>
                                <field name="signed_xml" filename="filename" />
                                <field name="filename" />
                                <field name="xml_sha256" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="incoming_exchange_view_search" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.exchange.search</field>
        <field name="model">l10n_cl.incoming.dte.exchange</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="supplier_vat" />
                <field name="recipient_email" />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <filter
                    name="filter_not_sent"
                    string="Not Sent"
                    domain="[('state', '=', 'signed')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="incoming_exchange_action" model="ir.actions.act_window">
        <field name="name">Exchange Responses</field>
        <field name="res_model">l10n_cl.incoming.dte.exchange</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
