<odoo>
    <record id="view_company_form_dte_exchange" model="ir.ui.view">
        <field name="name">res.company.form.dte.exchange</field>
        <field name="model">res.company</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_core.view_company_form_dte_environment"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dte_sii_settings']" position="inside">
                <group
                    string="Exchange Responses to Suppliers"
                    groups="l10n_cl_dte_core.group_dte_manager"
                >
                    <field name="l10n_cl_dte_exchange_auto_send" />
                    <field name="l10n_cl_dte_exchange_site" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
