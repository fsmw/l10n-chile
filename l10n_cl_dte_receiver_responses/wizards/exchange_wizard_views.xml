<odoo>
    <record id="exchange_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.incoming.dte.exchange.wizard.form</field>
        <field name="model">l10n_cl.incoming.dte.exchange.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    One signed response is prepared per supplier. A DTE that already has a response of this kind keeps it; use Resend on that response to email it again.
                </div>
                <group>
                    <group>
                        <field name="kind" />
                        <field name="result_state" invisible="kind != 'result'" />
                        <field name="gloss" invisible="kind != 'result'" />
                        <field
                            name="site"
                            invisible="kind != 'receipt'"
                            required="kind == 'receipt'"
                        />
                        <field name="send_now" />
                        <field name="registry_response_id" invisible="1" />
                    </group>
                </group>
                <field name="document_ids" />
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Sign"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
