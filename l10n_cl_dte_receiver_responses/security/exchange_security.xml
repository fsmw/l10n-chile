<odoo>
    <record id="rule_incoming_exchange_company" model="ir.rule">
        <field name="name">Incoming DTE exchange responses: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_incoming_dte_exchange" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_incoming_exchange_line_company" model="ir.rule">
        <field name="name">Incoming DTE exchange details: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_incoming_dte_exchange_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
