<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_mipyme_recovery" model="ir.module.category">
        <field name="name">SMWLAB DTE Recovery</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_mipyme_recovery_user" model="res.groups">
        <field name="name">MiPyme DTE Recovery Operator</field>
        <field name="category_id" ref="module_category_mipyme_recovery" />
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>
    <record id="group_mipyme_recovery_manager" model="res.groups">
        <field name="name">MiPyme DTE Recovery Manager</field>
        <field name="category_id" ref="module_category_mipyme_recovery" />
        <field name="implied_ids" eval="[(4, ref('group_mipyme_recovery_user'))]" />
    </record>
    <record id="rule_dte_recovery_company" model="ir.rule">
        <field name="name">MiPyme recovery multi-company</field>
        <field name="model_id" ref="model_l10n_cl_dte_recovery" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mipyme_recovery_user'))]" />
    </record>
</odoo>
