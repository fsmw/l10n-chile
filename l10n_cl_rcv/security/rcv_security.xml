<odoo>
    <record id="group_rcv_user" model="res.groups">
        <field name="name">RCV SII / Consulta</field>
        <field name="category_id" ref="base.module_category_accounting" />
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>
    <record id="group_rcv_manager" model="res.groups">
        <field name="name">RCV SII / Gestión</field>
        <field name="category_id" ref="base.module_category_accounting" />
        <field
            name="implied_ids"
            eval="[(4, ref('l10n_cl_rcv.group_rcv_user')), (4, ref('account.group_account_manager'))]"
        />
    </record>
    <record id="rule_rcv_period_company" model="ir.rule">
        <field name="name">RCV periods by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_period" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_sync_company" model="ir.rule">
        <field name="name">RCV syncs by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_sync" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_summary_company" model="ir.rule">
        <field name="name">RCV summaries by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_summary" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_document_company" model="ir.rule">
        <field name="name">RCV documents by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_document" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_observation_company" model="ir.rule">
        <field name="name">RCV observations by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_observation" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_boleta_company" model="ir.rule">
        <field name="name">RCV daily receipts by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_boleta_daily" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
    <record id="rule_rcv_match_log_company" model="ir.rule">
        <field name="name">RCV match logs by allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_rcv_match_log" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>
</odoo>
