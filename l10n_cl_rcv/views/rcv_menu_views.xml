<odoo>
    <!-- Keep RCV under Accounting, and let RCV users traverse this parent menu. -->
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('l10n_cl_rcv.group_rcv_user'))]" />
    </record>

    <record id="action_rcv_period_year" model="ir.actions.server">
        <field name="name">Libros RCV</field>
        <field name="model_id" ref="model_l10n_cl_rcv_period" />
        <field name="state">code</field>
        <field name="code">action = model.action_open_year()</field>
    </record>
    <menuitem
        id="menu_rcv_root"
        name="RCV SII"
        parent="account.menu_finance_entries"
        sequence="65"
        groups="l10n_cl_rcv.group_rcv_user"
        action="action_rcv_period_year"
    />
    <menuitem
        id="menu_rcv_sync"
        name="Sincronizaciones"
        parent="menu_rcv_root"
        action="action_rcv_sync"
        sequence="30"
        groups="l10n_cl_rcv.group_rcv_user"
    />
    <menuitem
        id="menu_rcv_sync_request"
        name="Sincronizar período"
        parent="menu_rcv_root"
        action="action_rcv_sync_wizard"
        sequence="31"
        groups="l10n_cl_rcv.group_rcv_manager"
    />
    <menuitem
        id="menu_rcv_csv_import"
        name="Importar CSV"
        parent="menu_rcv_root"
        action="action_rcv_csv_wizard"
        sequence="32"
        groups="l10n_cl_rcv.group_rcv_manager"
    />
    <menuitem
        id="menu_rcv_documents"
        name="Documentos RCV"
        parent="menu_rcv_root"
        action="action_rcv_document"
        sequence="20"
        groups="l10n_cl_rcv.group_rcv_user"
    />
    <menuitem
        id="menu_rcv_year"
        name="Cambiar año fiscal"
        parent="menu_rcv_root"
        action="action_rcv_year_wizard"
        sequence="10"
        groups="l10n_cl_rcv.group_rcv_user"
    />
</odoo>
