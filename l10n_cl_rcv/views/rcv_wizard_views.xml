<odoo>
    <record id="view_rcv_sync_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.rcv.sync.wizard.form</field>
        <field name="model">l10n.cl.rcv.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronizar RCV">
                <group>
                    <field name="company_id" />
                    <field name="year" />
                    <field name="month" />
                    <field name="operation" />
                </group>
                <footer>
                    <button
                        name="action_sync"
                        type="object"
                        string="Solicitar sincronización"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rcv_year_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.rcv.year.wizard.form</field>
        <field name="model">l10n.cl.rcv.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Año fiscal RCV">
                <group>
                    <field name="year" />
                </group>
                <footer>
                    <button
                        name="action_open_year"
                        type="object"
                        string="Abrir libros"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rcv_csv_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.rcv.csv.wizard.form</field>
        <field name="model">l10n.cl.rcv.csv.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar CSV RCV">
                <group>
                    <field name="company_id" />
                    <field name="year" />
                    <field name="month" />
                    <field name="operation" />
                    <field name="upload" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rcv_draft_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.rcv.draft.wizard.form</field>
        <field name="model">l10n.cl.rcv.draft.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear borrador de compra desde RCV">
                <div
                    class="alert alert-info"
                    role="alert"
                >Se cargaron datos sugeridos desde el RCV. Revise proveedor, cuenta e impuestos antes de crear el borrador; el XML puede reemplazar el detalle.</div>
                <group>
                    <field name="document_id" />
                    <field name="partner_candidate_ids" invisible="1" />
                    <field name="partner_id" invisible="not partner_candidate_ids" />
                    <field
                        name="new_partner_name"
                        string="Nombre del nuevo proveedor"
                        invisible="partner_candidate_ids"
                        required="not partner_candidate_ids"
                    />
                    <field name="xml_file" filename="xml_filename" />
                    <field name="xml_filename" invisible="1" />
                </group>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="partner_candidate_ids"
                >No existe un proveedor con el RUT del RCV. Se creará con este nombre y quedará asociado al borrador al confirmar.</div>
                <field name="line_ids" invisible="xml_file">
                    <list editable="bottom">
                        <field name="name" />
                        <field name="quantity" />
                        <field name="price_unit" />
                        <field name="account_id" />
                        <field name="tax_ids" widget="many2many_tags" />
                        <field
                            name="analytic_distribution"
                            widget="analytic_distribution"
                            groups="analytic.group_analytic_accounting"
                        />
                        <field name="company_id" column_invisible="1" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create_draft"
                        type="object"
                        string="Crear borrador"
                        class="btn-primary"
                        confirm="¿Crear el borrador de factura con estos datos? Puedes volver a editarlo antes de contabilizarlo."
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rcv_link_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.rcv.link.wizard.form</field>
        <field name="model">l10n.cl.rcv.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Vincular documento RCV">
                <group>
                    <field name="document_id" />
                    <field name="candidate_move_ids" invisible="1" />
                    <field name="move_id" domain="[('id', 'in', candidate_move_ids)]" />
                    <field
                        name="reason"
                        placeholder="Explique la revisión que confirma este vínculo."
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmar vínculo"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rcv_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sincronizar RCV</field>
        <field name="res_model">l10n.cl.rcv.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_sync_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="action_rcv_csv_wizard" model="ir.actions.act_window">
        <field name="name">Importar CSV RCV</field>
        <field name="res_model">l10n.cl.rcv.csv.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_csv_wizard_form" />
        <field name="target">new</field>
    </record>
    <record id="action_rcv_year_wizard" model="ir.actions.act_window">
        <field name="name">Seleccionar año RCV</field>
        <field name="res_model">l10n.cl.rcv.year.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rcv_year_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
