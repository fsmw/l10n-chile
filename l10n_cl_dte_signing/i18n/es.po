#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "A DTE must contain exactly one Documento."
msgstr "El DTE debe contener exactamente un elemento Documento."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "A signed DTE needs one Documento and Signature."
msgstr "Un DTE firmado requiere un elemento Documento y uno Signature."

#. module: l10n_cl_dte_signing
#: model_terms:ir.ui.view,arch_db:l10n_cl_dte_signing.view_company_form_dte_signing
msgid "Chilean DTE"
msgstr "DTE chileno"

#. module: l10n_cl_dte_signing
#: model:ir.model,name:l10n_cl_dte_signing.model_res_company
msgid "Companies"
msgstr "Compañías"

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Configure a signing certificate for this company."
msgstr "Configure un certificado de firma para esta compañía."

#. module: l10n_cl_dte_signing
#: model:ir.model.fields,field_description:l10n_cl_dte_signing.field_res_company__dte_certificate_id
msgid "DTE Signing Certificate"
msgstr "Certificado de firma DTE"

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Documento ID must be unique in the DTE."
msgstr "El ID de Documento debe ser único en el DTE."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Documento must have a unique ID attribute."
msgstr "Documento debe tener un atributo ID único."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Only RSA XMLDSig public keys are supported."
msgstr "Solo se admiten claves públicas RSA para XMLDSig."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Only a DTE manager can use the signing certificate."
msgstr "Solo un responsable de DTE puede usar el certificado de firma."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "Only an active CAF can sign a TED."
msgstr "Solo un CAF activo puede firmar un TED."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "TED CAF key or FRMT is malformed."
msgstr "La clave CAF o la FRMT del TED está mal formada."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF belongs to another company."
msgstr "El CAF pertenece a otra compañía."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF does not contain an RSA private key."
msgstr "El CAF no contiene una clave privada RSA."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF does not contain an RSA public key."
msgstr "El CAF no contiene una clave pública RSA."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF private key is not valid PEM."
msgstr "La clave privada del CAF no es PEM válido."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF private key must be RSA."
msgstr "La clave privada del CAF debe ser RSA."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF public key is not valid PEM."
msgstr "La clave pública del CAF no es PEM válido."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The CAF public key must be RSA."
msgstr "La clave pública del CAF debe ser RSA."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The DTE already contains an XML signature."
msgstr "El DTE ya contiene una firma XML."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The Documento digest does not match."
msgstr "El resumen criptográfico de Documento no coincide."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The TED FRMT signature is invalid."
msgstr "La firma FRMT del TED no es válida."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The TED must include a CAF element."
msgstr "El TED debe incluir un elemento CAF."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The TED signature input must be the DD node."
msgstr "La entrada de firma del TED debe ser el nodo DD."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The TED signing input must be the DD node."
msgstr "La entrada para firmar el TED debe ser el nodo DD."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML RSA public key is invalid."
msgstr "La clave pública RSA del XML no es válida."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML cannot be canonicalized."
msgstr "No se puede canonicalizar el XML."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML certificate is not valid DER/Base64."
msgstr "El certificado XML no es DER/Base64 válido."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML digest algorithm is unsupported."
msgstr "El algoritmo de resumen criptográfico XML no es compatible."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML input is not well-formed."
msgstr "El XML de entrada no está bien formado."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML input must be bytes without a DTD."
msgstr "El XML de entrada debe ser una secuencia de bytes sin DTD."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML root element must be DTE."
msgstr "El elemento raíz del XML debe ser DTE."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML signature algorithms are unsupported."
msgstr "Los algoritmos de firma XML no son compatibles."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML signature contains invalid Base64."
msgstr "La firma XML contiene datos Base64 no válidos."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML signature does not reference Documento."
msgstr "La firma XML no hace referencia a Documento."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML signature is incomplete."
msgstr "La firma XML está incompleta."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The XML signature is invalid."
msgstr "La firma XML no es válida."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The configured certificate has no private key."
msgstr "El certificado configurado no tiene clave privada."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The configured signing certificate is not valid."
msgstr "El certificado de firma configurado no es válido."

#. module: l10n_cl_dte_signing
#. odoo-python
#: code:addons/l10n_cl_dte_signing/services/signature_service.py:0
msgid "The generated TED signature did not verify with the CAF key pair."
msgstr "La firma TED generada no se verificó con el par de claves del CAF."
