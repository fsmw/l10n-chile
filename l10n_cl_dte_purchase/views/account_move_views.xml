<odoo>
    <record id="view_move_form_dte_purchase" model="ir.ui.view">
        <field name="name">account.move.form.dte.purchase</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_cl_dte_account.view_move_form_dte_issuance"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dte_references']" position="attributes">
                <attribute
                    name="invisible"
                >move_type != 'out_invoice' and not (move_type == 'in_invoice' and dte_document_type_code == '46')</attribute>
            </xpath>
            <xpath expr="//div[@name='dte_issuance_unavailable']" position="after">
                <div
                    name="dte_purchase_issuance_info"
                    class="alert alert-info"
                    role="alert"
                    colspan="2"
                    invisible="move_type != 'in_invoice' or dte_document_type_code != '46' or dte_document_ids"
                >
                    The company issues this purchase invoice DTE 46 on behalf of the
                    supplier and retains its whole VAT. Taxable lines need 19% VAT and
                    the total VAT retention; the supplier needs a valid Chilean RUT.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
