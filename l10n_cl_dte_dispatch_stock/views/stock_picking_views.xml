<odoo>
    <record id="view_picking_form_dte_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.form.dte.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="dte_dispatch_ids" invisible="1" />
                <button
                    name="action_create_dte_dispatch"
                    type="object"
                    string="Create Dispatch Guide"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="state != 'done' or picking_type_code != 'outgoing' or dte_dispatch_ids"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_dte_dispatch"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    string="Dispatch Guide"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="not dte_dispatch_ids"
                />
            </xpath>
        </field>
    </record>
</odoo>
