<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bcentral_rate_range_wizard_form" model="ir.ui.view">
        <field name="name">l10n.cl.bcentral.rate.range.wizard.form</field>
        <field name="model">l10n.cl.bcentral.rate.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Obtener Tasas">
                <group>
                    <field name="currency_id" />
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <footer>
                    <button
                        name="action_fetch_rates"
                        type="object"
                        string="Obtener Tasas"
                        class="oe_highlight"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
