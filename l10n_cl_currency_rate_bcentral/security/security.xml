<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_bcentral_admin" model="res.groups">
        <field name="name">Bcentral Administrator</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="group_bcentral_user" model="res.groups">
        <field name="name">Bcentral User</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
