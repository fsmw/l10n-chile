<odoo>
    <record id="view_move_form_dte_issuance" model="ir.ui.view">
        <field name="name">account.move.form.dte.issuance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_issue_dte_33" type="object" string="Issue DTE 33" class="btn-primary" groups="l10n_cl_dte_core.group_dte_user" invisible="state != 'posted' or move_type != 'out_invoice' or l10n_latam_document_type_id.code != '33'" />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="l10n_latam_document_type_id" invisible="1" />
                <field name="dte_document_ids" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
