<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_payment_term_form_dte" model="ir.ui.view">
        <field name="name">account.payment.term.form.dte</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='early_discount']" position="before">
                <field
                    name="l10n_cl_sii_code"
                    invisible="'CL' not in fiscal_country_codes"
                />
            </xpath>
        </field>
    </record>
</odoo>
