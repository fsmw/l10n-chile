<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_cl_dte_pos.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]/span" position="replace">
            <span>
                <i class="fa fa-file-text-o me-2" />
                <t t-if="pos.isChileanCompany()">
                    <t t-esc="currentOrder.invoice_type === 'factura' ? 'Factura' : 'Boleta'" />
                </t>
                <t t-else="">Invoice</t>
            </span>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-att-class">{ 'highlight active': highlightInvoiceButton() }</attribute>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]/i[last()]" position="attributes">
            <attribute name="t-attf-class">{{ highlightInvoiceButton() ? 'fa-check-square text-action' : 'fa-square-o' }}</attribute>
        </xpath>
    </t>
</templates>
