<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_cl_dte_pos.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <xpath expr="//h1[hasclass('tracking-number')]" position="before">
            <div t-if="props.data.company.cl_vat"
                 class="pos-receipt-order-data fw-bold text-center">
                <span>RUT: <t t-out="props.data.company.cl_vat" /></span>
                <div t-if="props.data.l10n_latam_document_type">
                    <t t-out="props.data.l10n_latam_document_type" />
                    <span>N.º: <t t-out="props.data.l10n_latam_document_number" /></span>
                </div>
                <div t-else="" class="text-warning">
                    Comprobante POS: DTE pendiente de sincronización
                </div>
                <div t-if="props.data.date"><t t-out="props.data.date" /></div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <div t-if="props.data.partner" class="pos-receipt-partner text-center">
                <div>Cliente: <t t-esc="props.data.partner.name" /></div>
                <div>RUT: <t t-esc="props.data.partner.vat" /></div>
                <div>
                    Dirección:
                    <t t-esc="props.data.partner.street" />
                    <t t-if="props.data.partner.street2" t-esc="props.data.partner.street2" />
                </div>
                <div>Comuna: <t t-esc="props.data.partner.city" /></div>
                <div>Giro: <t t-esc="props.data.partner.l10n_cl_activity_description" /></div>
                <div>Teléfono: <t t-esc="props.data.partner.phone" /></div>
            </div>
        </xpath>
    </t>
</templates>
