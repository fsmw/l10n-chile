<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="l10n_cl_dte_pos.PaymentScreenButtons"
        t-inherit="point_of_sale.PaymentScreenButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[contains(@class, 'js_invoice')]" position="attributes">
            <attribute
                name="t-if"
            >pos.company.country_id?.code !== 'CL' || !pos.session.dte_pos_accounting_mode</attribute>
        </xpath>
    </t>
</templates>
