<odoo>
    <record id="view_pos_order_form_dte" model="ir.ui.view">
        <field name="name">pos.order.form.dte</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_dte_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                >
                    <field
                        name="dte_document_count"
                        widget="statinfo"
                        string="DTE Documents"
                    />
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Chilean DTE" name="dte_pos_information">
                    <field name="dte_document_code" />
                    <field name="dte_issuance_state" />
                    <field name="dte_related_document_ids" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
