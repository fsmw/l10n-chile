<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_l10n_cl_dte" model="ir.ui.view">
        <field name="name">pos.payment.method.form.l10n.cl.dte</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="l10n_cl_dte_company_country_code" invisible="1" />
                <field name="is_card_payment"
                       invisible="l10n_cl_dte_company_country_code != 'CL'" />
            </xpath>
        </field>
    </record>
</odoo>
