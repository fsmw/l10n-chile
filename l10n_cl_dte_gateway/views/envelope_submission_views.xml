<odoo>
    <record id="view_sii_envelope_submission_form" model="ir.ui.view">
        <field name="name">l10n_cl.sii.envelope.submission.form</field>
        <field name="model">l10n_cl.sii.envelope.submission</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_refresh_response"
                        type="object"
                        string="Refresh Response"
                        icon="fa-refresh"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <button
                        name="action_enqueue_send"
                        type="object"
                        string="Queue SII Envelope"
                        class="btn-primary"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="state not in ['pending', 'error']"
                    />
                    <button
                        name="action_enqueue_status_query"
                        type="object"
                        string="Query SII Status"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="state not in ['submitted', 'processing', 'outcome_unknown'] or not track_id"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <field
                        name="reported_rejection"
                        invisible="1"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    />
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="not reported_rejection"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    >
                        <field name="response_notice" nolabel="1" />
                    </div>
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="state not in ['pending', 'sending']"
                    >The transmission runs in the background. Use Refresh Response to load its result. Query SII Status becomes available when the SII assigns a TrackID.</div>
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="state not in ['submitted', 'processing']"
                    >The SII received the envelope. This does not yet confirm acceptance of its DTE. Use Query SII Status, then Refresh Response to load the result.</div>
                    <group
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="not response_code and not response_warning"
                    >
                        <group string="SII Response">
                            <field name="response_code" />
                            <field name="response_received_at" />
                        </group>
                        <group string="Response Details">
                            <field name="response_detail" />
                            <field
                                name="response_warning"
                                invisible="not response_warning"
                            />
                        </group>
                    </group>
                    <group>
                        <group string="Transmission">
                            <field name="name" string="File" />
                            <field name="company_id" />
                            <field name="environment" />
                            <field name="track_id" string="TrackID" />
                            <field
                                name="transport_code"
                                invisible="not transport_code"
                            />
                            <field name="submitted_at" />
                            <field name="last_checked_at" />
                        </group>
                        <group string="Envelope Evidence">
                            <field
                                name="idempotency_key"
                                string="Transmission Identifier"
                            />
                            <field
                                name="request_digest"
                                string="Envelope Fingerprint"
                            />
                            <field name="request_filename" />
                            <field
                                name="request_xml"
                                filename="request_filename"
                                groups="l10n_cl_dte_core.group_dte_manager"
                            />
                        </group>
                    </group>
                    <group
                        string="Document Results"
                        invisible="not response_document_summary"
                        groups="l10n_cl_dte_core.group_dte_manager"
                    >
                        <field
                            name="response_document_summary"
                            nolabel="1"
                            colspan="2"
                            readonly="1"
                        />
                    </group>
                    <field name="attempt_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="operation" />
                            <field name="started_at" />
                            <field name="finished_at" />
                            <field name="state" />
                            <field name="request_digest" optional="hide" />
                            <field name="response_digest" optional="hide" />
                            <field name="error_summary" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
