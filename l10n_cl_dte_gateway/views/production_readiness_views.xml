<odoo>
    <record id="production_readiness_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.production.readiness.wizard.form</field>
        <field name="model">l10n_cl.dte.production.readiness.wizard</field>
        <field name="arch" type="xml">
            <form string="Production SII Readiness">
                <div class="alert alert-warning" role="alert">
                    Local configuration review only. This does not contact or certify
                    the company with the SII and will not issue a DTE.
                </div>
                <group>
                    <field name="company_id" />
                    <field name="result" />
                    <field name="checked_at" />
                </group>
                <group string="DTE types the company plans to issue">
                    <field name="document_scope_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="document_code" />
                        </list>
                    </field>
                </group>
                <group>
                    <button
                        name="action_open_signing_profiles"
                        string="Signing profiles"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_open_caf_authorizations"
                        string="CAF and folios"
                        type="object"
                        class="btn-secondary"
                    />
                </group>
                <field name="diagnostic_line_ids" nolabel="1">
                    <list create="0" edit="0" delete="0">
                        <field name="sequence" widget="handle" />
                        <field name="level" />
                        <field name="code" />
                        <field name="message" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_check_readiness"
                        string="Check readiness"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_production_readiness_wizard" model="ir.actions.act_window">
        <field name="name">Production SII Readiness</field>
        <field name="res_model">l10n_cl.dte.production.readiness.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="production_readiness_wizard_view_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_production_readiness"
        name="Production SII Readiness"
        parent="l10n_cl_dte_core.menu_dte_configuration"
        action="action_production_readiness_wizard"
        sequence="90"
        groups="l10n_cl_dte_core.group_dte_manager"
    />
</odoo>
