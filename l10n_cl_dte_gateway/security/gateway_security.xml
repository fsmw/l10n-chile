<odoo>
    <record id="rule_electronic_submission_company" model="ir.rule">
        <field name="name">DTE submissions: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_electronic_submission" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_submission_attempt_company" model="ir.rule">
        <field name="name">DTE attempts: allowed companies</field>
        <field name="model_id" ref="model_l10n_cl_submission_attempt" />
        <field name="groups" eval="[(4, ref('l10n_cl_dte_core.group_dte_user'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
